{
  "name": "journey",
  "version": "1.0.0",
  "description": "Session capture, replay and journey analytics for websites (HCL Discover / Glassbox style).",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "test:e2e": "npm run build && node --disable-warning=ExperimentalWarning --import tsx --test test/e2e/*.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "simulate": "node scripts/simulate.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
